# Application Environment
NODE_ENV=development

# Server Port (Local Wrangler Dev)
PORT=8787

# Client API Base Path (Local Vite Dev Proxy)
VITE_API_URL=/api

# ─────────────────────────────────────────────────────────────────────────────
# AI Assistant — OpenRouter (EPIC-008)
# ─────────────────────────────────────────────────────────────────────────────

# API key de OpenRouter para el Asistente IA de proyectos.
# Obtener en https://openrouter.ai/settings/keys
# Requerida en producción; en tests usa FakeAIProvider (sin credenciales).
# ⚠ NUNCA incluir el valor real aquí ni en control de versiones.
# En Cloudflare: configurar como secreto con `wrangler secret put OPENROUTER_API_KEY`
OPENROUTER_API_KEY=

# Nombre del modelo de lenguaje a utilizar vía OpenRouter.
# Valor por defecto si se omite: google/gemini-2.0-flash-lite:free
# Otros modelos compatibles (verificar disponibilidad y créditos en openrouter.ai):
#   openai/gpt-4o-mini
#   anthropic/claude-3-haiku
#   meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=google/gemini-2.0-flash-lite:free

# Note: Production secrets must be managed via Cloudflare Dashboard or GitHub Secrets.
# Never commit real credentials, tokens, or connection strings.
