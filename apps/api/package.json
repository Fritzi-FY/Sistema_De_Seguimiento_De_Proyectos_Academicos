{
  "name": "@is488/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "migrate:plan": "node migrations/runner.ts plan",
    "migrate:apply": "node migrations/runner.ts apply",
    "migrate:reconcile": "node migrations/runner.ts reconcile",
    "test:migrations": "node --test migrations/migrator.node-test.ts",
    "typecheck:migrations": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions --types node migrations/runner.ts migrations/migrator.node-test.ts migrations/adapters.test.ts"
  },
  "dependencies": {
    "@is488/shared": "^0.1.0",
    "hono": "^4.13.13",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@types/pg": "8.23.1",
    "wrangler": "^4.149.0"
  }
}
