{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "is488-api-local-only",
  "main": "src/local-worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "local": {
      "vars": {
        "NODE_ENV": "development",
        "PERSISTENCE_MODE": "postgres",
        "DATABASE_URL": "postgresql://is488_dev_runtime@127.0.0.1:55490/is488_dev",
      },
    },
  },
}
